---
import type { ICONS } from '../content.config';

/**
 * Die fünf Sinnbilder der Leistungen als Inline-SVG – so erben sie die
 * Farbe aus dem umgebenden Kreis und bleiben in jeder Größe scharf.
 * Welches Icon eine Leistung nutzt, wird in TinaCMS ausgewählt.
 */
interface Props {
  name: (typeof ICONS)[number];
  class?: string;
}

const { name, class: klasse } = Astro.props;
---

<svg
  class:list={['icon', klasse]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'dokument' && (
    <>
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
      <path d="M14 3v5h5" />
      <path d="M9 13h6M9 17h4" />
    </>
  )}

  {name === 'stift' && (
    <>
      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" />
      <path d="M14.5 5.5l3 3" />
    </>
  )}

  {name === 'buch' && (
    <>
      <path d="M12 6.5C10.5 5.2 8.6 4.6 6 4.6H3.5v13H6c2.6 0 4.5.6 6 1.9" />
      <path d="M12 6.5c1.5-1.3 3.4-1.9 6-1.9h2.5v13H18c-2.6 0-4.5.6-6 1.9" />
      <path d="M12 6.5v13.9" />
    </>
  )}

  {name === 'funken' && (
    <>
      <path d="M12 3.5l1.7 4.3 4.3 1.7-4.3 1.7L12 15.5l-1.7-4.3L6 9.5l4.3-1.7z" />
      <path d="M18 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z" />
      <path d="M6.2 15.4l.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5z" />
    </>
  )}

  {name === 'blatt' && (
    <>
      <path d="M12 21V9" />
      <path d="M12 12.5c0-2.8 2.1-5 5-5h2.5c0 2.8-2.2 5-5 5z" />
      <path d="M12 17c0-2.2-1.7-4-4-4H5.5c0 2.2 1.8 4 4 4z" />
      <path d="M12 9c0-2.4 1.4-4.4 3.4-5.2C15.7 6 14.2 8.2 12 9z" />
    </>
  )}
</svg>

<style>
  .icon {
    width: 100%;
    height: 100%;
  }
</style>

---
/**
 * Das "M"-Signet aus dem Layout: ein geschwungenes M mit Pinselstrich.
 * Der Buchstabe kommt aus der Schreibschrift, damit er ohne Bilddatei
 * scharf bleibt und die Farben aus den Tokens erbt.
 */
interface Props {
  /** Größe des Buchstabens (CSS-Länge) */
  groesse?: string;
  hell?: boolean;
  class?: string;
}

const { groesse = '2.6rem', hell = false, class: klasse } = Astro.props;
---

<span
  class:list={['monogramm', { hell }, klasse]}
  style={`--groesse: ${groesse}`}
  aria-hidden="true"
>
  <span class="buchstabe">M</span>
  <svg class="pinsel" viewBox="0 0 60 30" focusable="false">
    <path
      d="M6 22 C 18 8, 34 6, 52 12"
      fill="none"
      stroke="currentColor"
      stroke-width="4"
      stroke-linecap="round"
      opacity="0.85"
    />
  </svg>
</span>

<style>
  .monogramm {
    position: relative;
    display: inline-block;
    line-height: 1;
  }

  .buchstabe {
    position: relative;
    z-index: 1;
    display: block;
    font-family: var(--font-script);
    font-size: var(--groesse);
    font-weight: 600;
    color: var(--c-green);
  }

  .pinsel {
    position: absolute;
    right: -0.18em;
    top: 0.1em;
    width: 0.85em;
    height: auto;
    font-size: var(--groesse);
    color: var(--c-terracotta);
  }

  .hell .buchstabe {
    color: var(--c-white);
  }

  .hell .pinsel {
    color: rgba(255, 255, 255, 0.55);
  }
</style>

# Zugangsdaten für TinaCMS Cloud.
# Diese Datei ist die Vorlage: kopieren nach ".env" und dort die echten Werte
# eintragen. Die ".env" wird bewusst nicht ins Git eingecheckt.
#
# Die beiden Werte stehen im Tina-Cloud-Projekt unter "Overview" bzw. "Tokens":
# https://app.tina.io

NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Branch, in den die Redaktion ihre Änderungen schreibt.
TINA_BRANCH=main

# Endgültige Adresse der Website (für sitemap.xml und Vorschaubilder).
SITE_URL=https://kati.dbm-connect.de
